---
import ContactSection from "@/components/sections/contact-section.astro";
import ExperienceSection from "@/components/sections/experience-section.astro";
import HeroSection from "@/components/sections/hero-section.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Footer from "@/components/sections/footer.astro";
---

<BaseLayout>
  <div class="app-shell">
    <HeroSection />
    <main id="main-content" class="main-content">
      <div class="panel-scroll main-scroll">
        <div class="content-container">
          <ExperienceSection />
          <ContactSection />
          <Footer />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .app-shell {
    position: relative;

    display: flex;
    flex-direction: column;

    @media (min-width: 1024px) {
      flex-direction: row;
      height: 100dvh;
      overflow: hidden;
    }
  }

  .main-content {
    flex: 1;
    display: flex;
    overflow: hidden;
  }

  .main-scroll {
    flex: 1;
  }

  .content-container {
    max-width: 56rem;
    margin: 0 auto;
  }
</style>
