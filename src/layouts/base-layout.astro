---
import EasterEggs from "@/components/easter-eggs/easter-eggs.astro";
import SeoHead from "@/components/ui/seo-head.astro";
import ThemeToggle from "@/components/ui/theme-toggle.astro";
import ShortcutHint from "@/components/easter-eggs/shortcut-hint/shortcut-hint.astro";
import { config } from "@/config";
import "../styles/global.css";
import { Font } from "astro:assets";
import { ToastContainer } from "@/components/islands";

type Props = {
  title?: string;
};

const { title = config.seo.title } = Astro.props;
---

<html lang="en">
  <head>
    <SeoHead title={title} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" sizes="192x192" href="/logo192.png" />
    <meta
      name="theme-color"
      content="#f4f5f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1a1b"
      media="(prefers-color-scheme: dark)"
    />
    <Font cssVariable="--font-sans" />
    {/* Inline theme script — runs before paint to prevent FOUC */}
    <script is:inline>
      function themeInit() {
        const theme = localStorage.getItem("theme") ?? "system";
        const resolved =
          theme === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : theme;
        if (resolved === "dark") document.documentElement.classList.add("dark");
      }

      themeInit();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <aside
      class="theme-toggle-wrapper"
      role="complementary"
      aria-label="Color theme">
      <ThemeToggle />
    </aside>

    <aside
      class="shortcut-hint-wrapper"
      role="complementary"
      aria-label="Keyboard shortcuts">
      <ShortcutHint />
    </aside>

    <slot />
    <ToastContainer client:only={true} />
    <EasterEggs />

    <style>
      .theme-toggle-wrapper {
        position: fixed;
        inset-block-start: var(--space-lg);
        inset-inline-end: max(
          var(--space-md),
          calc((100dvw - 80rem) / 2 + var(--space-md))
        );
        z-index: 9000;
      }

      .shortcut-hint-wrapper {
        position: fixed;
        inset-block-end: var(--space-lg);
        inset-inline-end: max(
          var(--space-md),
          calc((100dvw - 80rem) / 2 + var(--space-md))
        );
        z-index: 9500;

        @media (max-width: 1024px) {
          display: none;
        }
      }

      .skip-link {
        position: fixed;
        top: -100%;
        left: 50%;
        z-index: 9999;
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-md);
        font-size: var(--text-base);
        font-weight: 600;
        background-color: var(--c-accent);
        color: #fff;
        text-decoration: none;
        transition: top var(--transition-fast);

        &:focus {
          top: var(--space-md);
        }
      }
    </style>
  </body>
</html>
