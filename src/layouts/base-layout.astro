---
import EasterEggs from "@/components/easter-eggs/easter-eggs.astro";
import SeoHead from "@/components/ui/seo-head.astro";
import { config } from "@/config";
import "../styles/global.css";
import { Font } from "astro:assets";

type Props = {
  title?: string;
};

const { title = config.seo.title } = Astro.props;
---

<html lang="en">
  <head>
    <SeoHead title={title} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" sizes="192x192" href="/logo192.png" />
    <meta
      name="theme-color"
      content="#f4f5f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1a1b"
      media="(prefers-color-scheme: dark)"
    />
    <Font cssVariable="--font-sans" />
    {/* Inline theme script — runs before paint to prevent FOUC */}
    <script is:inline>
      function themeInit() {
        const theme = localStorage.getItem("theme") ?? "system";
        const resolved =
          theme === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : theme;
        if (resolved === "dark") document.documentElement.classList.add("dark");
      }

      themeInit();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <EasterEggs />
  </body>
</html>
