---
import type { ExperienceRole } from "../../types";
import { formatDuration } from "@/lib/format-duration";

type Props = {
  role: ExperienceRole;
  showPeriod: boolean;
};

const { role, showPeriod } = Astro.props;

const period = `${role.start} — ${role.end}`;
const duration = formatDuration(role.start, role.end);
---

<div class="role">
  <h4 class="role-title">{role.role}</h4>
  {
    showPeriod && (
      <div class="role-period">
        <span>{period}</span>
        <span>{duration}</span>
      </div>
    )
  }
</div>

<style>
  .role {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @container experience (min-width: 480px) {
    .role {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }

  .role-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--c-text);
    transition: color var(--transition-fast);
  }

  .role-period {
    font-size: var(--text-sm);
    color: var(--c-muted);

    & > * {
      display: block;
    }

    & > :not(:last-child) {
      margin-block-end: var(--space-2xs);
    }
  }

  @container experience (min-width: 480px) {
    .role-period {
      & > * {
        text-align: end;
      }
    }
  }
</style>
