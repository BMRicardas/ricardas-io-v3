---
import type { Experience } from "../../types";
import ExperienceRoleItem from "./experience-role-item.astro";
import { formatDuration } from "@/lib/format-duration";

type Props = {
  exp: Experience;
};

const { exp } = Astro.props;

const newestRole = exp.roles[0];
const oldestRole = exp.roles[exp.roles.length - 1];

const isCurrent = newestRole.end === "Present";
const period = `${oldestRole.start} — ${newestRole.end}`;
const totalDuration = formatDuration(oldestRole.start, newestRole.end);
const isGrouped = exp.roles.length > 1;
const subtitle = isGrouped
  ? `${totalDuration} · ${exp.roles.length} roles`
  : totalDuration;
---

<article class="experience-card" data-current={isCurrent}>
  <div class="meta">
    <h3 class="company-name">{exp.company}</h3>
    <p class="meta-date">{period}</p>
    <p class="meta-date">{subtitle}</p>
  </div>
  <ul class="role-list" role="list">
    {
      exp.roles.map((role) => (
        <li class="role-list-item">
          <ExperienceRoleItem role={role} showPeriod={isGrouped} />
        </li>
      ))
    }
  </ul>
</article>

<style>
  .experience-card {
    padding: var(--space-lg) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    position: relative;
  }

  .experience-card::before {
    content: "";
    position: absolute;
    top: calc(var(--space-lg) + calc((var(--text-base) / 2) - 0.2rem));
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--c-border);
    display: none;
    box-shadow: 0 0 0 3px var(--c-bg);
    transform: translateX(calc(-50% - 0.5px));
    z-index: 1;
  }

  .experience-card[data-current="true"]::before {
    background: var(--c-accent);
  }

  .experience-card[data-current="true"]::after {
    content: "";
    position: absolute;
    top: calc(var(--space-lg) + calc((var(--text-base) / 2) - 0.2rem));
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--c-accent);
    display: none;
    transform: translateX(calc(-50%));
    animation: dot-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
  }

  @keyframes dot-pulse {
    0% {
      opacity: 0.7;
      transform: translateX(-50%) scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: translateX(-50%) scale(3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-card[data-current="true"]::after {
      animation: none;
    }
  }

  @container experience (min-width: 470px) {
    .experience-card {
      grid-template-columns: 140px 1fr;
      gap: var(--space-xl);
      padding-left: var(--space-md);
    }
    .experience-card::before,
    .experience-card[data-current="true"]::after {
      display: block;
    }
  }

  @container experience (min-width: 640px) {
    .experience-card {
      grid-template-columns: 160px 1fr;
    }
  }

  .meta > :first-child {
    margin-block-end: var(--space-sm);
  }

  .company-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--c-text);
    line-height: var(--line-height-snug);
  }

  .experience-card[data-current="true"] .company-name {
    color: var(--c-accent);
  }

  .meta-date {
    font-size: var(--text-sm);
    color: var(--c-muted);
    line-height: 1.5;
  }

  .role-list {
    list-style-type: none;
  }

  .role-list-item:not(:only-child) {
    &:not(:first-child) {
      padding-block-start: 1.25rem;
    }
    &:not(:last-child) {
      padding-block-end: 1.25rem;
      border-bottom: 1px solid var(--c-border-subtle);
    }
  }
</style>
