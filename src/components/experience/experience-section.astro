---
import { getCollection } from "astro:content";
import ExperienceCard from "./experience-card.astro";
import SectionLabel from "../ui/section-label.astro";

const experiences = await getCollection("experience");
---

<section
  id="section-experience"
  aria-labelledby="heading-experience"
  class="experience-section">
  <SectionLabel id="heading-experience">Experience</SectionLabel>
  <ul class="experience-list">
    {
      experiences.map(({ data: exp }) => (
        <li class="experience-list-item">
          <ExperienceCard exp={exp} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .experience-section {
    container: experience / inline-size;
    padding: var(--space-lg) var(--space-md);

    @media (min-width: 640px) {
      padding: var(--space-xl) var(--space-lg);
    }

    @media (min-width: 1024px) {
      padding: var(--space-3xl) var(--space-2xl);
    }
  }

  .experience-list {
    @container experience (min-width: 480px) {
      border-left: 1px solid var(--c-border-subtle);
    }
  }

  .experience-list-item {
    list-style-type: none;
    border-block-end: 1px solid var(--c-border-subtle);
  }
</style>
