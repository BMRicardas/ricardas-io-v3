---
import { config } from "@/config";
import Typewriter from "@/components/ui/typewriter.astro";
import IsometricCube from "@/components/ui/isometric-cube.astro";
import { CONTACT_LINKS } from "@/constants";
import Icon from "@/components/ui/icon.astro";
import ContactLink from "@/components/ui/contact-link.astro";

type NameSegments = {
  chars: string[];
  class: "name-chars" | "name-chars hero-name-last";
  offset: number;
};

const nameSegments = [
  { chars: [...config.name.first], class: "name-chars", offset: 0 },
  {
    chars: [...config.name.last],
    class: "name-chars hero-name-last",
    offset: config.name.first.length,
  },
] satisfies NameSegments[];
---

<aside aria-label="Profile" class="hero-panel">
  <div>
    <h1 class="hero-name" id="hero-name">
      {
        nameSegments.map((seg, si) => (
          <>
            {si > 0 && <br />}
            <span class={seg.class}>
              {seg.chars.map((char, i) => (
                <span
                  class="name-char"
                  style={`animation-delay: ${(seg.offset + i) * 0.04 + si * 0.1}s`}>
                  {char}
                </span>
              ))}
            </span>
          </>
        ))
      }
    </h1>
    <Typewriter words={config.roles} />
    <p class="hero-bio">{config.bio}</p>
    <div class="hero-cube">
      <IsometricCube />
    </div>
  </div>
  <div class="hero-footer">
    {CONTACT_LINKS.map((link) => <ContactLink {...link} variant="icon" />)}
    <span class="hero-location">
      <Icon name="location" />
      {config.location}
    </span>
  </div>
</aside>

<style>
  /* ── Panel layout ── */
  .hero-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    width: 100%;
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--c-border-subtle);

    @media (min-width: 640px) {
      padding: var(--space-md);
    }

    @media (min-width: 1024px) {
      width: 420px;
      height: 100%;
      padding-block: var(--space-lg);
      border-bottom: none;
      border-right: 1px solid var(--c-border-subtle);
    }
  }

  /* ── Name ── */
  .hero-name {
    position: relative;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin-block-end: var(--space-xs);
  }

  .name-chars {
    display: inline-flex;
  }

  .hero-name-last {
    color: var(--c-muted);
  }

  .name-char {
    display: inline-block;
    opacity: 0;
    animation: char-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* ── Bio & cube (desktop only) ── */
  .hero-bio {
    display: none;
    font-size: var(--text-base);
    line-height: 1.6;
    margin-top: var(--space-lg);
    max-width: 20rem;
    color: var(--c-muted);

    @media (min-width: 1024px) {
      display: block;
    }
  }

  .hero-cube {
    display: none;

    @media (min-width: 1024px) {
      display: block;
    }
  }

  /* ── Footer ── */
  .hero-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-location {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--c-muted);
  }

  /* ── Animation ── */
  @keyframes char-in {
    0% {
      opacity: 0;
      transform: translateY(0.3em) rotateX(-40deg);
      filter: blur(4px);
    }
    60% {
      opacity: 1;
      filter: blur(0);
    }
    80% {
      transform: translateY(-0.05em) rotateX(0deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotateX(0deg);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-char {
      animation: none;
      opacity: 1;
    }
  }
</style>
