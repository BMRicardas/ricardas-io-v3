---
type ThemeId = "light" | "dark" | "system";

type Theme = {
  id: ThemeId;
  label: Capitalize<ThemeId>;
  d: string;
};

const themes = [
  {
    id: "light",
    label: "Light",
    d: "M12 12m-5 0a5 5 0 1 0 10 0a5 5 0 1 0-10 0M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42",
  },
  {
    id: "dark",
    label: "Dark",
    d: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z",
  },
  {
    id: "system",
    label: "System",
    d: "M2 3h20a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8 21h8M12 17v4",
  },
] satisfies Theme[];
---

<fieldset class="theme-toggle" title="Theme change">
  <legend class="sr-only">Color theme</legend>
  {
    themes.map(({ id, label, d }) => (
      <label class="theme-option" title={`${label} theme`}>
        <input
          type="radio"
          name="theme"
          value={id}
          class="theme-radio sr-only"
          aria-label={label}
        />
        <span class="theme-option-visual" aria-hidden="true">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <path d={d} />
          </svg>
        </span>
      </label>
    ))
  }
</fieldset>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    background-color: var(--c-surface);
    border: 1px solid var(--c-border-subtle);
    border-radius: var(--radius-full);
    padding: var(--radius-sm);

    margin: 0;
    border-width: 1px;
  }

  .theme-option {
    display: inline-flex;
    cursor: pointer;
  }

  .theme-option-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--c-muted);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .theme-option:hover .theme-option-visual {
    color: var(--c-text);
  }

  .theme-radio:checked + .theme-option-visual {
    background: var(--c-border-subtle);
    color: var(--c-text);
  }

  .theme-radio:focus-visible + .theme-option-visual {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
</style>

<script>
  import { applyTheme } from "@/lib/change-theme";
  import { getStoredTheme, type ThemeId } from "@/lib/theme";

  function initThemeToggle() {
    const fieldset =
      document.querySelector<HTMLFieldSetElement>(".theme-toggle");
    if (!fieldset) return;

    const radios = fieldset.querySelectorAll<HTMLInputElement>(
      'input[name="theme"]',
    );

    const stored = getStoredTheme();
    radios.forEach((radio) => {
      radio.checked = radio.value === stored;
    });
    applyTheme(stored, radios);

    fieldset.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name !== "theme") return;
      applyTheme(target.value as ThemeId, radios);
    });

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (getStoredTheme() === "system") applyTheme("system", radios);
      });
  }

  initThemeToggle();
</script>
