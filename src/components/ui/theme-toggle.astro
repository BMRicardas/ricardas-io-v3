---
type ThemeId = "light" | "dark" | "system";

type Theme = {
  id: ThemeId;
  label: Capitalize<ThemeId>;
  d: string;
};

const themes = [
  {
    id: "light",
    label: "Light",
    d: "M12 12m-5 0a5 5 0 1 0 10 0a5 5 0 1 0-10 0M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42",
  },
  {
    id: "dark",
    label: "Dark",
    d: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z",
  },
  {
    id: "system",
    label: "System",
    d: "M2 3h20a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8 21h8M12 17v4",
  },
] satisfies Theme[];
---

<fieldset class="theme-toggle" aria-label="Color theme" title="Theme change">
  <legend class="sr-only">Color theme</legend>
  {
    themes.map(({ id, label, d }) => (
      <button
        type="button"
        data-theme={id}
        aria-label={label}
        aria-pressed="false"
        title={`${label} theme`}>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d={d} />
        </svg>
      </button>
    ))
  }
</fieldset>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 2px;
    background-color: var(--c-surface);
    border: 1px solid var(--c-border-subtle);
    border-radius: var(--radius-full);
    padding: var(--radius-sm);

    @media (min-width: 400px) {
      flex-direction: row;
    }

    & button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: none;
      border-radius: var(--radius-full);
      background: transparent;
      color: var(--c-muted);
      cursor: pointer;
      transition:
        background var(--transition-fast),
        color var(--transition-fast);

      &[aria-pressed="true"] {
        background: var(--c-border-subtle);
        color: var(--c-text);
      }
    }
  }
</style>

<script>
  import { applyTheme } from "@/lib/change-theme";

  function initThemeToggle() {
    const fieldset =
      document.querySelector<HTMLFieldSetElement>(".theme-toggle");
    if (!fieldset) return;

    const buttons =
      fieldset.querySelectorAll<HTMLButtonElement>("button[data-theme]");

    function getStored(): string {
      return localStorage.getItem("theme") ?? "system";
    }

    // Init
    applyTheme(getStored());

    // Click handlers
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyTheme(btn.dataset.theme!);
      });
    });

    // Listen for OS theme changes
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (getStored() === "system") applyTheme("system");
      });
  }

  initThemeToggle();
</script>
