---
import type { HTMLAttributes } from "astro/types";
import { icons, type IconName } from "@/lib/icons";

type Props = HTMLAttributes<"svg"> & {
  name: IconName;
  size?: number;
};

const { name, size = 40, ...rest } = Astro.props;

const path = icons[name];
const resolvedSize = size;
---

<svg
  class="icon"
  viewBox="0 0 640 640"
  width={resolvedSize}
  height={resolvedSize}
  aria-hidden="true"
  fill="currentColor"
  {...rest}>
  <path d={path}></path>
</svg>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
