---
type Props = {
  words: readonly string[];
};

const { words } = Astro.props;
---

<p class="typewriter">
  <span class="sr-only">{words.join(", ")}</span>
  <span
    class="typewriter-text"
    data-words={JSON.stringify(words)}
    aria-hidden="true"></span>
  <span class="typewriter-cursor" aria-hidden="true">|</span>
</p>

<style>
  .typewriter {
    font-size: var(--text-base);
    font-weight: 500;
    margin-top: 1.25rem;
    min-height: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--c-accent);
  }

  .typewriter-cursor {
    color: var(--c-accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      animation: none;
    }
  }
</style>

<script>
  function initTypewriter() {
    const el = document.querySelector<HTMLParagraphElement>(".typewriter");
    if (!el) return;

    const textEl = el.querySelector<HTMLSpanElement>(".typewriter-text")!;
    const words: string[] = JSON.parse(textEl.dataset.words ?? "[]");
    if (words.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (prefersReducedMotion.matches) {
      textEl.textContent = words[0];
      return;
    }

    const TYPE_SPEED = 80;
    const DELETE_SPEED = 40;
    const PAUSE_AFTER_WORD = 2000;

    let wordIndex = 0;
    let charIndex = 0;
    let deleting = false;
    let timeoutId: number | null = null;
    let isPaused = document.hidden;

    function clearScheduled() {
      if (timeoutId !== null) {
        clearTimeout(timeoutId);
        timeoutId = null;
      }
    }

    function tick() {
      if (isPaused) return;

      const current = words[wordIndex % words.length];
      const isFullyTyped = !deleting && charIndex === current.length;
      const delay = isFullyTyped
        ? PAUSE_AFTER_WORD
        : deleting
          ? DELETE_SPEED
          : TYPE_SPEED;

      timeoutId = window.setTimeout(() => {
        if (isFullyTyped) {
          deleting = true;
        } else if (deleting) {
          if (charIndex === 0) {
            deleting = false;
            wordIndex++;
          } else {
            charIndex--;
          }
        } else {
          charIndex++;
        }

        textEl.textContent = words[wordIndex % words.length].slice(
          0,
          charIndex,
        );
        tick();
      }, delay);
    }

    // Pause when tab is backgrounded; resume when visible
    document.addEventListener("visibilitychange", () => {
      isPaused = document.hidden;
      if (isPaused) {
        clearScheduled();
      } else {
        tick();
      }
    });

    // Respect runtime reduced-motion changes
    prefersReducedMotion.addEventListener("change", (e) => {
      if (e.matches) {
        clearScheduled();
        textEl.textContent = words[0];
      } else {
        tick();
      }
    });

    tick();
  }

  initTypewriter();
</script>
